#!/usr/bin/env sh
# The first utterance of the Junzi Harness. Wire this as your harness startup
# banner so it is the first thing emitted, before any agent acts.
#   - A fixed opening precept (the creed) is printed first.
#   - Below it, a rotating "precept of the day" from precepts.txt (the classics).
#     Edit precepts.txt to change or extend the rotating pool. See PRECEPTS.md.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PRECEPTS="$DIR/precepts.txt"

cat <<'EOF'

  仁   THE JUNZI HARNESS   仁

  "Is it not pleasant to learn with a constant
   perseverance and application?"
                          — Confucius, Analects
EOF

# --- Rotating precept of the day, from precepts.txt ---
if [ -f "$PRECEPTS" ]; then
  N=$(grep -c . "$PRECEPTS")
  if [ "$N" -gt 0 ]; then
    DAY=$(date +%j | sed 's/^0*//')
    [ -z "$DAY" ] && DAY=0
    IDX=$(( (DAY % N) + 1 ))
    P=$(grep . "$PRECEPTS" | sed -n "${IDX}p")
    [ -n "$P" ] && printf '\n  \342\235\226 %s\n\n' "$P"
  fi
fi
